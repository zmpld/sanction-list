# Leave empty for same-origin /api (localhost via Vite proxy, Vercel monorepo deploy)
# Set to your backend URL when frontend and backend are deployed separately:
# VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=

# Only needed for manual PDF upload (browser-side Gemini calls)
VITE_GEMINI_API_KEY=
